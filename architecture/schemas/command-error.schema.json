{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://method-hub.local/architecture/schemas/command-error.schema.json",
    "title":  "Command Error",
    "description":  "Stable researcher-facing failure envelope shared by Web and remote command clients.",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "error_id",
                     "code",
                     "category",
                     "http_status",
                     "retryable",
                     "rule_id",
                     "object_refs",
                     "researcher_message",
                     "smallest_correction",
                     "occurred_at"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "$ref":  "common-definitions.schema.json#/$defs/schemaVersion"
                                          },
                       "error_id":  {
                                        "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                    },
                       "code":  {
                                    "type":  "string",
                                    "enum":  [
                                                 "AUTHENTICATION_REQUIRED",
                                                 "DELEGATION_NOT_ACTIVE",
                                                 "COMMAND_SCHEMA_INVALID",
                                                 "COMMAND_DIGEST_MISMATCH",
                                                 "IDEMPOTENCY_KEY_REUSED",
                                                 "INVALID_TRANSITION",
                                                 "RUN_ALREADY_SUBMITTED",
                                                 "CANCELLATION_REQUESTED",
                                                 "CONTROL_HEAD_STALE",
                                                 "TARGET_STATE_MISMATCH",
                                                 "TARGET_NOT_FOUND",
                                                 "DEPENDENCY_CLOSURE_INCOMPLETE",
                                                 "NO_STATE_CHANGE",
                                                 "PUBLICATION_CONFLICT"
                                             ]
                                },
                       "category":  {
                                        "type":  "string",
                                        "enum":  [
                                                     "authentication",
                                                     "authorization",
                                                     "schema",
                                                     "digest",
                                                     "idempotency",
                                                     "transition",
                                                     "concurrency",
                                                     "dependency"
                                                 ]
                                    },
                       "http_status":  {
                                           "type":  "integer",
                                           "enum":  [
                                                        400,
                                                        401,
                                                        403,
                                                        404,
                                                        409,
                                                        422
                                                    ]
                                       },
                       "retryable":  {
                                         "type":  "boolean"
                                     },
                       "rule_id":  {
                                       "type":  "string",
                                       "pattern":  "^MH-[0-9]{2}$"
                                   },
                       "object_refs":  {
                                           "type":  "array",
                                           "uniqueItems":  true,
                                           "items":  {
                                                         "type":  "string",
                                                         "minLength":  1
                                                     }
                                       },
                       "field_path":  {
                                          "type":  "string",
                                          "minLength":  1
                                      },
                       "researcher_message":  {
                                                  "type":  "string",
                                                  "minLength":  1
                                              },
                       "smallest_correction":  {
                                                   "type":  "string",
                                                   "minLength":  1
                                               },
                       "occurred_at":  {
                                           "type":  "string",
                                           "format":  "date-time"
                                       }
                   },
    "oneOf":  [
                  {
                      "properties":  {
                                         "code":  {
                                                      "const":  "AUTHENTICATION_REQUIRED"
                                                  },
