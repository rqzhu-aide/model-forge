{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://method-hub.local/architecture/schemas/decision-record.schema.json",
    "title":  "Researcher Decision Record",
    "description":  "An immutable compact lead synthesis that informs the researcher without selecting or launching the next action. Current authority and alignment are derived separately.",
    "type":  "object",
    "additionalProperties":  true,
    "required":  [
                     "schema_version",
                     "decision_id",
                     "generation_id",
                     "phase",
                     "source_run_id",
                     "generated_by",
                     "headline",
                     "current_conclusion",
                     "fundamental_contribution",
                     "what_changed",
                     "strongest_evidence_ids",
                     "principal_uncertainty",
                     "principal_risk",
                     "material_disagreement",
                     "smallest_decisive_result",
                     "scientific_outcome",
                     "available_actions",
                     "content_sha256",
                     "created_at",
                     "authority_at_creation",
                     "alignment_at_creation",
                     "research_attention_at_creation"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "$ref":  "common-definitions.schema.json#/$defs/schemaVersion"
                                          },
                       "decision_id":  {
                                           "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                       },
                       "generation_id":  {
                                             "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                         },
                       "phase":  {
                                     "$ref":  "common-definitions.schema.json#/$defs/phaseId"
                                 },
                       "source_run_id":  {
                                             "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                         },
                       "method_identity":  {
                                               "$ref":  "common-definitions.schema.json#/$defs/methodIdentity"
                                           },
                       "generated_by":  {
                                            "const":  "research_lead"
                                        },
                       "headline":  {
                                        "type":  "string",
                                        "minLength":  1,
                                        "maxLength":  500
                                    },
                       "current_conclusion":  {
                                                  "type":  "string",
                                                  "minLength":  1
                                              },
                       "fundamental_contribution":  {
                                                        "type":  "string",
                                                        "minLength":  1
                                                    },
                       "what_changed":  {
                                            "type":  "string",
                                            "minLength":  1
                                        },
                       "strongest_evidence_ids":  {
                                                      "type":  "array",
                                                      "items":  {
                                                                    "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                                },
                                                      "uniqueItems":  true
                                                  },
                       "principal_uncertainty":  {
                                                     "type":  "string",
                                                     "minLength":  1
                                                 },
                       "principal_risk":  {
                                              "type":  "string",
                                              "minLength":  1
                                          },
                       "material_disagreement":  {
                                                     "type":  "array",
                                                     "items":  {
                                                                   "type":  "string",
                                                                   "minLength":  1
                                                               },
                                                     "uniqueItems":  true
                                                 },
                       "smallest_decisive_result":  {
                                                        "type":  "string",
                                                        "minLength":  1,
                                                        "description":  "The smallest new result that would materially change the present decision."
                                                    },
                       "scientific_outcome":  {
                                                  "$ref":  "common-definitions.schema.json#/$defs/scientificOutcome"
                                              },
                       "available_actions":  {
                                                 "type":  "array",
                                                 "minItems":  1,
                                                 "items":  {
                                                               "type":  "object",
                                                               "additionalProperties":  true,
                                                               "required":  [
                                                                                "action_id",
                                                                                "action_type",
                                                                                "label",
                                                                                "consequence",
                                                                                "launches_run",
                                                                                "requires_user_action"
                                                                            ],
                                                               "properties":  {
                                                                                  "action_id":  {
                                                                                                    "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                                                                },
                                                                                  "action_type":  {
                                                                                                      "type":  "string",
                                                                                                      "enum":  [
                                                                                                                   "run_phase",
                                                                                                                   "rerun_phase",
                                                                                                                   "change_method",
                                                                                                                   "retire_method",
                                                                                                                   "reactivate_method",
                                                                                                                   "return_upstream",
                                                                                                                   "defer",
                                                                                                                   "prepare_submission"
                                                                                                               ]
                                                                                                  },
                                                                                  "label":  {
                                                                                                "type":  "string",
                                                                                                "minLength":  1
                                                                                            },
                                                                                  "consequence":  {
                                                                                                      "type":  "string",
                                                                                                      "minLength":  1
                                                                                                  },
                                                                                  "launches_run":  {
                                                                                                       "type":  "boolean"
                                                                                                   },
                                                                                  "requires_user_action":  {
                                                                                                               "const":  true
                                                                                                           },
                                                                                  "target_phase":  {
                                                                                                       "$ref":  "common-definitions.schema.json#/$defs/phaseId"
                                                                                                   }
                                                                              },
                                                               "allOf":  [
                                                                             {
                                                                                 "if":  {
                                                                                            "properties":  {
                                                                                                               "launches_run":  {
                                                                                                                                    "const":  true
                                                                                                                                }
                                                                                                           },
                                                                                            "required":  [
                                                                                                             "launches_run"
                                                                                                         ]
                                                                                        },
                                                                                 "then":  {
                                                                                              "required":  [
                                                                                                               "target_phase"
                                                                                                           ]
                                                                                          }
                                                                             }
                                                                         ]
                                                           }
                                             },
                       "rerun_question":  {
                                              "type":  "string",
                                              "minLength":  1
                                          },
                       "content_sha256":  {
                                              "$ref":  "common-definitions.schema.json#/$defs/sha256"
                                          },
                       "publication_receipt_id":  {
                                                      "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                  },
                       "published_at":  {
                                            "type":  "string",
                                            "format":  "date-time"
                                        },
                       "created_at":  {
                                          "type":  "string",
                                          "format":  "date-time"
                                      },
                       "authority_at_creation":  {
                                                     "$ref":  "common-definitions.schema.json#/$defs/creationAuthority"
                                                 },
                       "alignment_at_creation":  {
                                                     "$ref":  "common-definitions.schema.json#/$defs/alignmentAssessment"
                                                 },
                       "research_attention_at_creation":  {
                                                              "$ref":  "common-definitions.schema.json#/$defs/researchAttention"
                                                          }
                   },
    "allOf":  [
                  {
                      "if":  {
                                 "properties":  {
                                                    "phase":  {
                                                                  "enum":  [
                                                                               "P3",
                                                                               "P4",
                                                                               "P5"
                                                                           ]
                                                              }
                                                },
                                 "required":  [
                                                  "phase"
                                              ]
                             },
                      "then":  {
                                   "required":  [
                                                    "method_identity"
                                                ]
                               }
                  },
                  {
                      "if":  {
                                 "properties":  {
                                                    "authority_at_creation":  {
                                                                                  "const":  "formal_generation"
                                                                              }
                                                },
                                 "required":  [
                                                  "authority_at_creation"
                                              ]
                             },
                      "then":  {
                                   "required":  [
                                                    "publication_receipt_id",
                                                    "published_at"
                                                ]
                               },
                      "else":  {
                                   "not":  {
                                               "anyOf":  [
                                                             {
                                                                 "required":  [
                                                                                  "publication_receipt_id"
                                                                              ]
                                                             },
                                                             {
                                                                 "required":  [
                                                                                  "published_at"
                                                                              ]
                                                             }
                                                         ]
                                           }
                               }
                  }
              ]
}
