{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://method-hub.local/architecture/schemas/formal-generation-withdrawal-command.schema.json",
  "title": "Formal Generation Withdrawal Command",
  "description": "An authenticated correction command that withdraws one exact formal generation through an atomic authority transaction. It does not create a research run, replacement scientific generation, or role execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_type",
    "command_id",
    "idempotency_key",
    "project_id",
    "target",
    "expected_target_state",
    "expected_control_head",
    "reason",
    "requested_by",
    "content_sha256",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common-definitions.schema.json#/$defs/schemaVersion"
    },
    "command_type": {
      "const": "formal_generation_withdrawal"
    },
    "command_id": {
      "$ref": "common-definitions.schema.json#/$defs/stableId"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "project_id": {
      "$ref": "common-definitions.schema.json#/$defs/stableId"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_type",
        "generation_id",
        "content_sha256"
      ],
      "properties": {
        "record_id": {
          "$ref": "common-definitions.schema.json#/$defs/stableId"
        },
        "record_type": {
          "$ref": "common-definitions.schema.json#/$defs/recordType"
        },
        "generation_id": {
          "$ref": "common-definitions.schema.json#/$defs/stableId"
        },
        "content_sha256": {
          "$ref": "common-definitions.schema.json#/$defs/sha256"
        }
      }
    },
    "expected_target_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_state",
        "record_position",
        "record_state_sha256"
      ],
      "properties": {
        "publication_state": {
          "const": "formal"
        },
        "record_position": {
          "type": "string",
          "enum": ["current", "historical"]
        },
        "record_state_sha256": {
          "$ref": "common-definitions.schema.json#/$defs/sha256"
        }
      }
    },
    "expected_control_head": {
      "$ref": "#/$defs/expectedControlHead"
    },
    "reason": {
      "$ref": "#/$defs/reason"
    },
    "requested_by": {
      "$ref": "#/$defs/requestedBy"
    },
    "content_sha256": {
      "$ref": "common-definitions.schema.json#/$defs/sha256",
      "description": "SHA-256 of the RFC 8785 canonical command JSON with content_sha256 omitted."
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "expectedControlHead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_index_generation_id",
        "current_index_sha256",
        "last_event_sequence",
        "event_root_sha256"
      ],
      "properties": {
        "current_index_generation_id": {
          "$ref": "common-definitions.schema.json#/$defs/stableId"
        },
        "current_index_sha256": {
          "$ref": "common-definitions.schema.json#/$defs/sha256"
        },
        "last_event_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_root_sha256": {
          "$ref": "common-definitions.schema.json#/$defs/sha256"
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "explanation"],
      "properties": {
        "code": {
          "$ref": "common-definitions.schema.json#/$defs/stableId"
        },
        "explanation": {
          "$ref": "common-definitions.schema.json#/$defs/nonEmptyText"
        }
      }
    },
    "requestedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "operating_actor_type"],
      "properties": {
        "user_id": {
          "$ref": "common-definitions.schema.json#/$defs/stableId"
        },
        "operating_actor_type": {
          "type": "string",
          "enum": ["user", "authorized_remote_operator"]
        },
        "operator_id": {
          "$ref": "common-definitions.schema.json#/$defs/stableId"
        },
        "delegation_id": {
          "$ref": "common-definitions.schema.json#/$defs/stableId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operating_actor_type": {
                "const": "authorized_remote_operator"
              }
            },
            "required": ["operating_actor_type"]
          },
          "then": {
            "required": ["operator_id", "delegation_id"]
          }
        }
      ]
    }
  }
}
