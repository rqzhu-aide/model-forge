{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://method-hub.local/architecture/schemas/handoff.schema.json",
    "title":  "Role Handoff",
    "description":  "An immutable run-local research communication record that states what changed, what is supported, and what the next role must check.",
    "type":  "object",
    "additionalProperties":  true,
    "required":  [
                     "schema_version",
                     "handoff_id",
                     "run_id",
                     "phase",
                     "sequence",
                     "from_role",
                     "to_role",
                     "producer_profile_input_id",
                     "basis_generation_ids",
                     "completed_work",
                     "material_changes",
                     "statement_ids",
                     "evidence_ids",
                     "unresolved_issues",
                     "required_checks",
                     "handoff_artifact",
                     "created_at"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "$ref":  "common-definitions.schema.json#/$defs/schemaVersion"
                                          },
                       "handoff_id":  {
                                          "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                      },
                       "run_id":  {
                                      "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                  },
                       "phase":  {
                                     "$ref":  "common-definitions.schema.json#/$defs/phaseId"
                                 },
                       "sequence":  {
                                        "type":  "integer",
                                        "minimum":  1
                                    },
                       "from_role":  {
                                         "$ref":  "common-definitions.schema.json#/$defs/roleId"
                                     },
                       "to_role":  {
                                       "$ref":  "common-definitions.schema.json#/$defs/roleId"
                                   },
                       "producer_profile_input_id":  {
                                                         "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                     },
                       "method_identity":  {
                                               "$ref":  "common-definitions.schema.json#/$defs/methodIdentity"
                                           },
                       "basis_generation_ids":  {
                                                    "type":  "array",
                                                    "items":  {
                                                                  "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                              },
                                                    "uniqueItems":  true
                                                },
                       "completed_work":  {
                                              "type":  "array",
                                              "minItems":  0,
                                              "items":  {
                                                            "type":  "string",
                                                            "minLength":  1
                                                        }
                                          },
                       "material_changes":  {
                                                "type":  "array",
                                                "items":  {
                                                              "type":  "string",
                                                              "minLength":  1
                                                          },
                                                "uniqueItems":  true
                                            },
                       "statement_ids":  {
                                             "type":  "array",
                                             "items":  {
                                                           "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                       },
                                             "uniqueItems":  true
                                         },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "items":  {
                                                          "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                      },
                                            "uniqueItems":  true
                                        },
                       "unresolved_issues":  {
                                                 "type":  "array",
                                                 "items":  {
                                                               "type":  "object",
                                                               "additionalProperties":  true,
                                                               "required":  [
                                                                                "issue_id",
                                                                                "category",
                                                                                "severity",
                                                                                "statement",
                                                                                "consequence"
                                                                            ],
                                                               "properties":  {
                                                                                  "issue_id":  {
                                                                                                   "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                                                               },
                                                                                  "category":  {
                                                                                                   "type":  "string",
                                                                                                   "enum":  [
                                                                                                                "validity",
                                                                                                                "scope",
                                                                                                                "research_attention",
                                                                                                                "presentation",
                                                                                                                "identifiability",
                                                                                                                "computation",
                                                                                                                "empirical_testability",
                                                                                                                "reproducibility"
                                                                                                            ]
                                                                                               },
                                                                                  "severity":  {
                                                                                                   "type":  "string",
                                                                                                   "enum":  [
                                                                                                                "blocking",
                                                                                                                "major",
                                                                                                                "minor"
                                                                                                            ]
                                                                                               },
                                                                                  "statement":  {
                                                                                                    "type":  "string",
                                                                                                    "minLength":  1
                                                                                                },
                                                                                  "consequence":  {
                                                                                                      "type":  "string",
                                                                                                      "minLength":  1
                                                                                                  }
                                                                              }
                                                           }
                                             },
                       "required_checks":  {
                                               "type":  "array",
                                               "minItems":  0,
                                               "items":  {
                                                             "type":  "string",
                                                             "minLength":  1
                                                         },
                                               "uniqueItems":  true
                                           },
                       "handoff_artifact":  {
                                                "$ref":  "common-definitions.schema.json#/$defs/artifactPointer"
                                            },
                       "created_at":  {
                                          "type":  "string",
                                          "format":  "date-time"
                                      }
                   },
    "allOf":  [
                  {
                      "if":  {
                                 "properties":  {
                                                    "phase":  {
                                                                  "enum":  [
                                                                               "P3",
                                                                               "P4",
                                                                               "P5"
                                                                           ]
                                                              }
                                                },
                                 "required":  [
                                                  "phase"
                                              ]
                             },
                      "then":  {
                                   "required":  [
                                                    "method_identity"
                                                ]
                               }
                  }
              ]
}
