{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://method-hub.local/architecture/schemas/method.schema.json",
    "title":  "Structured Method Record",
    "description":  "An immutable structured scientific and mathematical generation for one method version. Lifecycle state is frozen in the generation; the current catalog selects which generation supplies the current lifecycle view.",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "record_id",
                     "generation_id",
                     "identity",
                     "title",
                     "lifecycle_state",
                     "scientific_question",
                     "rationale",
                     "summary",
                     "mathematical_definition",
                     "assumptions",
                     "literature_provenance",
                     "lineage",
                     "limitations",
                     "content_sha256",
                     "created_at",
                     "updated_at",
                     "authority_at_creation"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "$ref":  "common-definitions.schema.json#/$defs/schemaVersion"
                                          },
                       "record_id":  {
                                         "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                     },
                       "generation_id":  {
                                             "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                         },
                       "identity":  {
                                        "$ref":  "common-definitions.schema.json#/$defs/methodIdentity"
                                    },
                       "title":  {
                                     "type":  "string",
                                     "minLength":  1,
                                     "maxLength":  240
                                 },
                       "lifecycle_state":  {
                                               "type":  "string",
                                               "enum":  [
                                                            "proposed",
                                                            "active",
                                                            "retired"
                                                        ],
                                               "description":  "Portfolio lifecycle only. Feasibility and scientific support belong in assessments."
                                           },
                       "scientific_question":  {
                                                   "type":  "string",
                                                   "minLength":  1
                                               },
                       "rationale":  {
                                         "type":  "string",
                                         "minLength":  1
                                     },
                       "summary":  {
                                       "type":  "string",
                                       "minLength":  1
                                   },
                       "mathematical_definition":  {
                                                       "type":  "object",
                                                       "additionalProperties":  false,
                                                       "required":  [
                                                                        "canonical_artifact",
                                                                        "definition_locator",
                                                                        "defining_components",
                                                                        "canonical_definition"
                                                                    ],
                                                       "properties":  {
                                                                          "canonical_artifact":  {
                                                                                                     "$ref":  "common-definitions.schema.json#/$defs/artifactPointer"
                                                                                                 },
                                                                          "definition_locator":  {
                                                                                                     "type":  "string",
                                                                                                     "minLength":  1,
                                                                                                     "description":  "The uniquely named section containing every calculation-defining object."
                                                                                                 },
                                                                          "defining_components":  {
                                                                                                      "type":  "array",
                                                                                                      "minItems":  6,
                                                                                                      "maxItems":  6,
                                                                                                      "uniqueItems":  true,
                                                                                                      "items":  {
                                                                                                                    "type":  "string",
                                                                                                                    "enum":  [
                                                                                                                                 "target_or_estimand",
                                                                                                                                 "objective_or_estimating_equation",
                                                                                                                                 "algorithm_or_update_rule",
                                                                                                                                 "constraints_and_normalization",
                                                                                                                                 "tuning_definition",
                                                                                                                                 "calculation_defining_assumptions"
                                                                                                                             ]
                                                                                                                }
                                                                                                  },
                                                                          "canonical_definition":  {
                                                                              "$ref":  "#/$defs/canonicalMethodDefinition",
                                                                              "description":  "The complete calculation-defining payload hashed as method identity. Artifact metadata and explanatory prose are outside this payload."
                                                                          },
                                                                          "computational_consequences":    {
                                                                                                             "type":  "array",
                                                                                                             "items":  {
                                                                                                                           "type":  "string",
                                                                                                                           "minLength":  1
                                                                                                                       },
                                                                                                             "uniqueItems":  true
                                                                                                         }
                                                                      }
                                                   },
                       "assumptions":  {
                                           "type":  "array",
                                           "minItems":  1,
                                           "items":  {
                                                         "type":  "object",
                                                         "additionalProperties":  false,
                                                         "required":  [
                                                                          "assumption_id",
                                                                          "statement",
                                                                          "role"
                                                                      ],
                                                         "properties":  {
                                                                            "assumption_id":  {
                                                                                                  "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                                                              },
                                                                            "statement":  {
                                                                                              "type":  "string",
                                                                                              "minLength":  1
                                                                                          },
                                                                            "role":  {
                                                                                         "type":  "string",
                                                                                         "enum":  [
                                                                                                      "identification",
                                                                                                      "estimation",
                                                                                                      "computation",
                                                                                                      "inference",
                                                                                                      "interpretation"
                                                                                                  ]
                                                                                     }
                                                                        }
                                                     }
                                       },
                       "literature_provenance":  {
                                                     "type":  "array",
                                                     "minItems":  1,
                                                     "items":  {
                                                                   "type":  "object",
                                                                   "additionalProperties":  false,
                                                                   "required":  [
                                                                                    "citation_id",
                                                                                    "relation",
                                                                                    "contribution"
                                                                                ],
                                                                   "properties":  {
                                                                                      "citation_id":  {
                                                                                                          "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                                                                      },
                                                                                      "relation":  {
                                                                                                       "type":  "string",
                                                                                                       "enum":  [
                                                                                                                    "foundation",
                                                                                                                    "extension",
                                                                                                                    "contrast",
                                                                                                                    "benchmark",
                                                                                                                    "application_context"
                                                                                                                ]
                                                                                                   },
                                                                                      "contribution":  {
                                                                                                           "type":  "string",
                                                                                                           "minLength":  1
                                                                                                       }
                                                                                  }
                                                               }
                                                 },
                       "lineage":  {
                                       "type":  "object",
                                       "additionalProperties":  false,
                                       "required":  [
                                                        "change_class",
                                                        "change_summary",
                                                        "change_source"
                                                    ],
                                       "properties":  {
                                                          "predecessor":  {
                                                                              "$ref":  "common-definitions.schema.json#/$defs/methodIdentity"
                                                                          },
                                                          "change_class":  {
                                                                               "type":  "string",
                                                                               "enum":  [
                                                                                            "initial",
                                                                                            "editorial",
                                                                                            "mathematical",
                                                                                            "lifecycle"
                                                                                        ]
                                                                           },
                                                          "change_summary":  {
                                                                                 "type":  "string",
                                                                                 "minLength":  1
                                                                             },
                                                          "predecessor_generation_id":  {
                                                                                            "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                                                        },
                                                          "change_source":  {
                                                                                "oneOf":  [
                                                                                              {
                                                                                                  "type":  "object",
                                                                                                  "additionalProperties":  false,
                                                                                                  "required":  [
                                                                                                                   "kind",
                                                                                                                   "run_id"
                                                                                                               ],
                                                                                                  "properties":  {
                                                                                                                     "kind":  {
                                                                                                                                  "const":  "research_run"
                                                                                                                              },
                                                                                                                     "run_id":  {
                                                                                                                                    "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                                                                                                }
                                                                                                                 }
                                                                                              },
                                                                                              {
                                                                                                  "type":  "object",
                                                                                                  "additionalProperties":  false,
                                                                                                  "required":  [
                                                                                                                   "kind",
                                                                                                                   "command_id",
                                                                                                                   "command_sha256"
                                                                                                               ],
                                                                                                  "properties":  {
                                                                                                                     "kind":  {
                                                                                                                                  "const":  "method_lifecycle_command"
                                                                                                                              },
                                                                                                                     "command_id":  {
                                                                                                                                        "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                                                                                                    },
                                                                                                                     "command_sha256":  {
                                                                                                                                            "$ref":  "common-definitions.schema.json#/$defs/sha256"
                                                                                                                                        }
                                                                                                                 }
                                                                                              }
                                                                                          ]
                                                                            }
                                                      },
                                       "description":  "Immutable generation lineage. A lifecycle-only replacement names the exact predecessor generation and preserves the predecessor method identity, definition, and scientific content."
                                   },
                       "limitations":  {
                                           "type":  "array",
                                           "items":  {
                                                         "type":  "string",
                                                         "minLength":  1
                                                     },
                                           "uniqueItems":  true
                                       },
                       "content_sha256":  {
                                              "$ref":  "common-definitions.schema.json#/$defs/sha256"
                                          },
                       "created_at":  {
                                          "type":  "string",
                                          "format":  "date-time"
                                      },
                       "updated_at":  {
                                          "type":  "string",
                                          "format":  "date-time"
                                      },
                       "authority_at_creation":  {
                                                     "$ref":  "common-definitions.schema.json#/$defs/creationAuthority"
                                                 },
                       "publication_receipt_id":  {
                                                      "$ref":  "common-definitions.schema.json#/$defs/stableId"
                                                  },
                       "published_at":  {
                                            "type":  "string",
                                            "format":  "date-time"
                                        }
                   },
    "$defs":  {
        "canonicalMethodDefinition":  {
            "type":  "object",
            "additionalProperties":  false,
            "required":  [
                "definition_schema_version",
                "target_or_estimand",
                "objective_or_estimating_equation",
                "algorithm_or_update_rule",
                "constraints_and_normalization",
                "tuning_definition",
                "calculation_defining_assumptions"
            ],
            "properties":  {
                "definition_schema_version":  { "type": "string", "const": "1.0.0" },
                "target_or_estimand":  { "$ref": "#/$defs/namedMathematicalObject" },
                "objective_or_estimating_equation":  { "$ref": "#/$defs/namedMathematicalObject" },
                "algorithm_or_update_rule":  {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/algorithmStep" }
                },
                "constraints_and_normalization":  {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/namedMathematicalObject" }
                },
                "tuning_definition":  {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/tuningParameter" }
                },
                "calculation_defining_assumptions":  {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/definingAssumption" }
                }
            }
        },
        "namedMathematicalObject":  {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_id", "symbol", "definition"],
            "properties": {
                "object_id": { "$ref": "common-definitions.schema.json#/$defs/stableId" },
                "symbol": { "type": "string", "minLength": 1 },
                "definition": { "type": "string", "minLength": 1 },
                "domain": { "type": "string", "minLength": 1 }
            }
        },
        "algorithmStep":  {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "order", "operation"],
            "properties": {
                "step_id": { "$ref": "common-definitions.schema.json#/$defs/stableId" },
                "order": { "type": "integer", "minimum": 1 },
                "operation": { "type": "string", "minLength": 1 }
            }
        },
        "tuningParameter":  {
            "type": "object",
            "additionalProperties": false,
            "required": ["parameter_id", "symbol", "admissible_values", "selection_rule"],
            "properties": {
                "parameter_id": { "$ref": "common-definitions.schema.json#/$defs/stableId" },
                "symbol": { "type": "string", "minLength": 1 },
                "admissible_values": { "type": "string", "minLength": 1 },
                "selection_rule": { "type": "string", "minLength": 1 }
            }
        },
        "definingAssumption":  {
            "type": "object",
            "additionalProperties": false,
            "required": ["assumption_id", "statement", "mathematical_role"],
            "properties": {
                "assumption_id": { "$ref": "common-definitions.schema.json#/$defs/stableId" },
                "statement": { "type": "string", "minLength": 1 },
                "mathematical_role": { "type": "string", "minLength": 1 }
            }
        }
    },
    "allOf":  [
                  {
                      "if":  {
                                 "properties":  {
                                                    "lineage":  {
                                                                    "properties":  {
                                                                                       "change_class":  {
                                                                                                            "const":  "initial"
                                                                                                        }
                                                                                   },
                                                                    "required":  [
                                                                                     "change_class"
                                                                                 ]
                                                                }
                                                },
                                 "required":  [
                                                  "lineage"
                                              ]
                             },
                      "then":  {
                                   "properties":  {
                                                      "lineage":  {
                                                                      "not":  {
                                                                                  "anyOf":  [
                                                                                                {
                                                                                                    "required":  [
                                                                                                                     "predecessor"
                                                                                                                 ]
                                                                                                },
                                                                                                {
                                                                                                    "required":  [
                                                                                                                     "predecessor_generation_id"
                                                                                                                 ]
                                                                                                }
                                                                                            ]
                                                                              }
                                                                  }
                                                  }
                               },
                      "else":  {
                                   "properties":  {
                                                      "lineage":  {
                                                                      "required":  [
                                                                                       "predecessor"
                                                                                   ]
                                                                  }
                                                  }
                               }
                  },
                  {
                      "if":  {
                                 "properties":  {
                                                    "lineage":  {
                                                                    "properties":  {
                                                                                       "change_class":  {
                                                                                                            "const":  "lifecycle"
                                                                                                        }
                                                                                   },
                                                                    "required":  [
                                                                                     "change_class"
                                                                                 ]
                                                                }
                                                },
                                 "required":  [
                                                  "lineage"
                                              ]
                             },
                      "then":  {
                                   "properties":  {
                                                      "lifecycle_state":  {
                                                                              "enum":  [
                                                                                           "active",
                                                                                           "retired"
                                                                                       ]
                                                                          },
                                                      "lineage":  {
                                                                      "required":  [
                                                                                       "predecessor",
                                                                                       "predecessor_generation_id"
                                                                                   ],
                                                                      "properties":  {
                                                                                         "change_source":  {
                                                                                                               "properties":  {
                                                                                                                                  "kind":  {
                                                                                                                                               "const":  "method_lifecycle_command"
                                                                                                                                           }
                                                                                                                              },
                                                                                                               "required":  [
                                                                                                                                "kind"
                                                                                                                            ]
                                                                                                           }
                                                                                     }
                                                                  }
                                                  }
                               },
                      "else":  {
                                   "properties":  {
                                                      "lineage":  {
                                                                      "properties":  {
                                                                                         "change_source":  {
                                                                                                               "properties":  {
                                                                                                                                  "kind":  {
                                                                                                                                               "const":  "research_run"
                                                                                                                                           }
                                                                                                                              },
                                                                                                               "required":  [
                                                                                                                                "kind"
                                                                                                                            ]
                                                                                                           }
                                                                                     }
                                                                  }
                                                  }
                               }
                  },
                  {
                      "if":  {
                                 "properties":  {
                                                    "authority_at_creation":  {
                                                                                  "const":  "formal_generation"
                                                                              }
                                                },
                                 "required":  [
                                                  "authority_at_creation"
                                              ]
                             },
                      "then":  {
                                   "required":  [
                                                    "publication_receipt_id",
                                                    "published_at"
                                                ]
                               },
                      "else":  {
                                   "not":  {
                                               "anyOf":  [
                                                             {
                                                                 "required":  [
                                                                                  "publication_receipt_id"
                                                                              ]
                                                             },
                                                             {
                                                                 "required":  [
                                                                                  "published_at"
                                                                              ]
                                                             }
                                                         ]
                                           }
                               }
                  }
              ]
}
