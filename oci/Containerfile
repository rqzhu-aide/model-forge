# Method Hub OCI runtime image with Hermes baked in (Slice 2).
#
# This image is self-contained: it includes the Hermes Agent runtime so
# that no host Hermes installation needs to be mounted at runtime.
#
# Build (from method-hub repo root):
#   podman build \
#     --build-context hermes=/home/tez/.hermes/hermes-agent \
#     -t method-hub-runtime:latest \
#     -f oci/Containerfile .
#
# The --build-context makes the Hermes source available as a named
# context that COPY can reference.

FROM python:3.12-slim AS builder

# Install system build dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libffi-dev \
        libssl-dev \
        procps \
        git && \
    rm -rf /var/lib/apt/lists/*

# Copy the Hermes source from the named build context.
COPY --from=hermes / /opt/hermes-agent
WORKDIR /opt/hermes-agent

# Create a fresh venv and install Hermes dependencies.
# Extract dependencies from pyproject.toml into a requirements file,
# then pip install from it. This avoids inline shell-quoting issues.
RUN python3 -m venv /opt/hermes-agent/venv && \
    /opt/hermes-agent/venv/bin/pip install --no-cache-dir --upgrade pip && \
    python3 -c "\
import tomllib, pathlib; \
data = tomllib.loads(pathlib.Path('pyproject.toml').read_text()); \
deps = data['project']['dependencies']; \
pathlib.Path('/tmp/requirements.txt').write_text('\n'.join(deps) + '\n')" && \
    /opt/hermes-agent/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt

# Create the hermes wrapper script inside the venv bin.
RUN printf '#!/bin/bash\nexport PYTHONPATH=/opt/hermes-agent:${PYTHONPATH}\nexport HERMES_INSTALL=/opt/hermes-agent\nexec /opt/hermes-agent/venv/bin/python3 -c "from hermes_cli.main import main; main()" "$@"\n' \
    > /opt/hermes-agent/venv/bin/hermes && \
    chmod +x /opt/hermes-agent/venv/bin/hermes

# --------------------------------------------------------------------------- #
# Runtime stage
# --------------------------------------------------------------------------- #
FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libffi8 \
        libssl3 \
        procps \
        git && \
    rm -rf /var/lib/apt/lists/*

# Create the methodhub user.
RUN useradd --create-home --uid 1000 --shell /bin/bash methodhub

# Copy the built Hermes environment from the builder stage.
COPY --from=builder /opt/hermes-agent /opt/hermes-agent

# Symlink the hermes binary into PATH.
RUN ln -sf /opt/hermes-agent/venv/bin/hermes /usr/local/bin/hermes

# Create mount points for runtime bind-mounts.
RUN mkdir -p /workspace /home/methodhub/.hermes/profiles && \
    chown -R methodhub:methodhub /workspace /home/methodhub

# Set environment defaults.
ENV HERMES_HOME=/home/methodhub/.hermes
ENV HOME=/home/methodhub
ENV PYTHONPATH=/opt/hermes-agent
ENV PATH=/opt/hermes-agent/venv/bin:${PATH}

WORKDIR /workspace
USER methodhub
CMD ["/bin/bash"]
